          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 seats=250', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().keys[0].seats).to.eql(250); });"] }}]
        },
        {
          "name": "TC-48 (S5) [SIMULASI sisa 10 hari] Renew 1 bulan → 200",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/purchases/{{purchaseId}}/renew",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-API-Key", "value": "{{apikey}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"term_months\": 1\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 term_months=1', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().purchase.term_months).to.eql(1); });",
            "pm.test('expired = lama + 1 bulan (~40 hari)', () => { const d=(new Date(pm.response.json().purchase.expires_at)-Date.now())/8.64e7; pm.expect(d).to.be.within(38,42); });"
          ]}}]
        },
        {
          "name": "TC-49 (S5) [SIMULASI sisa 10 hari] Renew 7 bulan → 200",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/purchases/{{purchaseId}}/renew",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-API-Key", "value": "{{apikey}}" }],
            "body": { "mode": "raw", "raw": "{\"term_months\":7}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 term_months=7', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().purchase.term_months).to.eql(7); });"] }}]
        },
        {
          "name": "TC-4A (S5) [SIMULASI sisa 10 hari] Renew 36 bulan (tanpa batas atas) → 200",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/purchases/{{purchaseId}}/renew",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-API-Key", "value": "{{apikey}}" }],
            "body": { "mode": "raw", "raw": "{\"term_months\":36}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 term_months=36 term_years=3', () => { pm.response.to.have.status(200); const p=pm.response.json().purchase; pm.expect(p.term_months).to.eql(36); pm.expect(p.term_years).to.eql(3); });"] }}]
        },
        {
          "name": "TC-4B (S5) Renew −1 bulan → 400",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/purchases/{{purchaseId}}/renew",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-API-Key", "value": "{{apikey}}" }],
            "body": { "mode": "raw", "raw": "{\"term_months\":-1}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('400', () => pm.response.to.have.status(400));"] }}]
        }
      ]
    },
    {
      "name": "05 Validasi, Revoke & Audit",
      "item": [
        {
          "name": "TC-50 Validate key tanpa device → valid + info seat",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/validate",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"key\":\"{{licenseKey}}\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "const b = pm.response.json();",
            "pm.test('valid, ada seats/used/remaining', () => { pm.expect(b.valid).to.eql(true); pm.expect(b).to.include.keys('seats','used_seats','remaining_seats'); });"
          ]}}]
        },
        {
          "name": "TC-51 Validate key palsu → not_found",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/validate",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"key\":\"AAAAA-BBBBB-CCCCC-DDDDD-EEEEE\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('not_found', () => pm.expect(pm.response.json().reason).to.eql('not_found'));"] }}]
        },
        {
          "name": "TC-52 Activate key palsu → 404",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/activate",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"key\":\"AAAAA-BBBBB-CCCCC-DDDDD-EEEEE\",\"device_id\":\"x\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('404', () => pm.response.to.have.status(404));"] }}]
        },
        {
          "name": "TC-53 Activate tanpa device_id → 400",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/activate",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"key\":\"{{licenseKey}}\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('400', () => pm.response.to.have.status(400));"] }}]
        },
        {
          "name": "TC-54 Audit trail kontrak",
          "request": { "method": "GET", "url": "{{baseUrl}}/purchases/{{purchaseId}}/events", "header": [{ "key": "X-API-Key", "value": "{{apikey}}" }] },
          "event": [{ "listen": "test", "script": { "exec": [
            "const acts = pm.response.json().events.map(e => e.action);",
            "pm.test('issued, activated, deactivated, reissued, renewed, seats_added', () => ['issued','activated','deactivated','reissued','renewed','seats_added'].forEach(a => pm.expect(acts).to.include(a)));"
          ]}}]
        },
        {
          "name": "TC-55 Revoke key → 200",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/keys/{{licenseKey}}", "header": [{ "key": "X-API-Key", "value": "{{apikey}}" }] },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('200 revoked', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql('revoked'); });"] }}]
        },
        {
          "name": "TC-56 Activate setelah revoke → 403 revoked",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/activate",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"key\":\"{{licenseKey}}\",\"device_id\":\"dev-050\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('403 revoked', () => { pm.response.to.have.status(403); pm.expect(pm.response.json().reason).to.eql('revoked'); });"] }}]
        },
        {
          "name": "TC-57 Validate dev-050 setelah revoke → revoked",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/validate",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"key\":\"{{licenseKey}}\",\"device_id\":\"dev-050\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": ["pm.test('reason=revoked', () => pm.expect(pm.response.json().reason).to.eql('revoked'));"] }}]
        }
      ]
    }
  ]
}
