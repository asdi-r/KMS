    {
      "name": "01 Generate Key (Skenario 1: PT MUF, 1 tahun, 100 endpoint)",
      "item": [
        {
          "name": "TC-10 Generate PT MUF: 1 tahun, kuota 100 endpoint → 201, 1 key",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/purchase",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-API-Key", "value": "{{apikey}}" }],
            "body": { "mode": "raw", "raw": "{\n  \"customer_id\": \"PT-MUF\",\n  \"product\": \"ANTIVIRUS\",\n  \"quantity\": 100,\n  \"term_years\": 1\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201', () => pm.response.to.have.status(201));",
            "const b = pm.response.json();",
            "pm.test('1 license key', () => pm.expect(b.key.key).to.match(/^[A-Z0-9]{5}(-[A-Z0-9]{5}){4}$/));",
            "pm.test('kuota 100 seat, 0 terpakai', () => { pm.expect(b.key.seats).to.eql(100); pm.expect(b.key.used_seats).to.eql(0); });",
            "pm.test('quantity kontrak 100', () => pm.expect(b.purchase.quantity).to.eql(100));",
            "pm.test('periode 12 bulan', () => pm.expect(b.purchase.term_months).to.eql(12));",
            "pm.test('expired ~1 tahun', () => { const d=(new Date(b.purchase.expires_at)-Date.now())/8.64e7; pm.expect(d).to.be.within(364,367); });",
            "pm.collectionVariables.set('purchaseId', b.purchase.id);",
            "pm.collectionVariables.set('licenseKey', b.key.key);"
          ]}}]
        },
        {
          "name": "TC-11 term_years=3 → 400",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/purchase",
            "header": [{ "key": "Content-Type", "value": "application/json" }, { "key": "X-API-Key", "value": "{{apikey}}" }],
            "body": { "mode": "raw", "raw": "{\"customer_id\":\"PT-MUF\",\"product\":\"ANTIVIRUS\",\"quantity\":1,\"term_years\":3}" }
