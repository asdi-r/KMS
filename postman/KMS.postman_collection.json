    {
      "name": "02 Aktivasi Endpoint & Kuota Seat",
      "description": "Central antivirus PT MUF mengaktivasi key untuk tiap endpoint. Kuota 100 → aktivasi ke-101 ditolak.",
      "item": [
        {
          "name": "TC-20 Activate endpoint dev-001 → 200, used 1/100",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/activate",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"key\": \"{{licenseKey}}\",\n  \"device_id\": \"dev-001\",\n  \"hostname\": \"PC-FINANCE-01\"\n}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "const b = pm.response.json();",
            "pm.test('activated', () => pm.expect(b.activated).to.eql(true));",
            "pm.test('used_seats=1, remaining=99', () => { pm.expect(b.used_seats).to.eql(1); pm.expect(b.remaining_seats).to.eql(99); });",
            "pm.test('activation_token diberikan', () => pm.expect(b.activation_token).to.be.a('string').with.length.above(20));",
            "pm.collectionVariables.set('token001', b.activation_token);"
          ]}}]
        },
        {
          "name": "TC-21 Activate dev-001 lagi (idempotent) → 200, used tetap 1",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/activate",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"key\":\"{{licenseKey}}\",\"device_id\":\"dev-001\"}" }
          },
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200', () => pm.response.to.have.status(200));",
            "pm.test('used_seats tetap 1', () => pm.expect(pm.response.json().used_seats).to.eql(1));"
          ]}}]
        },
        {
          "name": "TC-22 Activate dev-002 … dev-100 (loop 99x) → semua 200",
          "request": {
            "method": "POST", "url": "{{baseUrl}}/activate",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\"key\":\"{{licenseKey}}\",\"device_id\":\"dev-{{devNo}}\"}" }
          },
          "event": [
            { "listen": "prerequest", "script": { "exec": [
              "let n = pm.collectionVariables.get('devNo');",
              "n = n ? parseInt(n) + 1 : 2;",
              "pm.collectionVariables.set('devNo', String(n).padStart(3,'0'));"
            ]}},
            { "listen": "test", "script": { "exec": [
              "pm.test('200', () => pm.response.to.have.status(200));",
              "const n = parseInt(pm.collectionVariables.get('devNo'));",
              "pm.test('used_seats = ' + n, () => pm.expect(pm.response.json().used_seats).to.eql(n));",
              "if (n < 100) { postman.setNextRequest('TC-22 Activate dev-002 … dev-100 (loop 99x) → semua 200'); } else { pm.collectionVariables.unset('devNo'); }"
            ]}}
          ]
        },
